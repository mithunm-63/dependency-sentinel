# Local development defaults
# Copy to .env only for local use. Never commit real passwords.

DATABASE_URL=jdbc:postgresql://localhost:5432/dependency_sentinel
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
FRONTEND_ORIGIN=http://localhost:5173
PORT=8081

